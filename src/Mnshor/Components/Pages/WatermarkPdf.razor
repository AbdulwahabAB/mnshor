@page "/watermark"
@rendermode InteractiveServer
@inject LocalizationState Loc
@inject IPdfEngine PdfEngine
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Loc["WatermarkPdfTitle"] - @Loc["AppName"]</PageTitle>

<a href="/" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>@Loc["BackToTools"]</span>
</a>

<div class="panel-card">
    <div class="panel-header">
        <div>
            <h1 class="panel-title">@Loc["WatermarkPdfTitle"]</h1>
            <p class="panel-desc">@Loc["WatermarkPdfDesc"]</p>
        </div>
    </div>

    @if (selectedFile == null)
    {
        <label class="smart-dropzone">
            <InputFile class="dropzone-input-overlay" OnChange="OnFileSelected" accept=".pdf" />
            <div class="dropzone-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                </svg>
            </div>
            <div class="dropzone-text">@Loc["DragDropPrompt"]</div>
            <div class="dropzone-subtext">PDF files only (Max 500 MB)</div>
        </label>
    }
    else
    {
        <div class="watermark-workspace">
            <!-- Left Main Stage: Document Header, Navigator & Live Preview Thumbnails -->
            <div class="watermark-main-stage">
                <!-- Document Meta Header -->
                <div class="file-item" style="margin-bottom: 1rem;">
                    <div class="file-info">
                        <div class="file-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                        </div>
                        <div>
                            <div class="file-name">@selectedFile.FileName</div>
                            <div class="file-meta-badges">
                                <span class="file-badge">@selectedFile.FormattedSize</span>
                                <span class="file-badge badge-accent">
                                    @selectedFile.PageCount @Loc["PagesCount"]
                                </span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button type="button" class="btn-lang" @onclick="ResetFile" style="color: var(--danger); border-color: var(--danger-border); background: var(--danger-surface);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                            <span>@Loc["Remove"]</span>
                        </button>
                    </div>
                </div>

                <!-- Large Document Navigator (Go to Page & Pagination) -->
                <div class="large-pdf-nav-bar">
                    <div class="nav-bar-group">
                        <label style="font-weight: 600; color: var(--text-secondary);">@Loc["JumpToPage"]</label>
                        <input type="number" min="1" max="@selectedFile.PageCount" @bind="jumpPageNumber" class="compact-input" style="width: 72px;" />
                        <button type="button" class="btn-tool-action" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;" @onclick="JumpToPageAsync">
                            @Loc["JumpButton"]
                        </button>
                    </div>

                    <div class="nav-bar-group">
                        <span style="color: var(--text-secondary);">
                            @Loc["ShowingPages"] <strong>@(ViewStartIndex + 1)–@(ViewEndIndex)</strong> @Loc["Of"] <strong>@selectedFile.PageCount</strong>
                        </span>

                        <button type="button" class="btn-tool-action" style="padding: 0.32rem 0.7rem; font-size: 0.8rem;"
                                disabled="@(currentViewPage <= 1)" @onclick="PrevViewPage">
                            @Loc["PrevView"]
                        </button>
                        <span style="font-weight: 600; padding: 0 0.25rem;">@currentViewPage / @TotalViewPages</span>
                        <button type="button" class="btn-tool-action" style="padding: 0.32rem 0.7rem; font-size: 0.8rem;"
                                disabled="@(currentViewPage >= TotalViewPages)" @onclick="NextViewPage">
                            @Loc["NextView"]
                        </button>

                        <label style="color: var(--text-secondary); margin-inline-start: 0.4rem;">@Loc["PerPage"]</label>
                        <select class="compact-input" value="@pageSize" @onchange="OnPageSizeChanged">
                            <option value="24">24</option>
                            <option value="48">48</option>
                            <option value="96">96</option>
                            <option value="0">@Loc["ShowAll"] (@selectedFile.PageCount)</option>
                        </select>
                    </div>
                </div>

                <!-- Interactive Page Thumbnails Grid with Live iLovePDF Watermark Overlay -->
                <div id="pdf-thumbnails-grid" class="page-thumbnails-grid">
                    @for (int i = ViewStartIndex; i < ViewEndIndex; i++)
                    {
                        int pageNum = i + 1;
                        bool isTargeted = IsPageTargeted(pageNum);

                        <div @key="pageNum" class="page-thumbnail-card" id="page-card-@pageNum" style="@(isTargeted ? "" : "opacity: 0.65;")">
                            <div class="page-card-header">
                                <span class="page-index-pill">
                                    @Loc["Page"] @pageNum
                                </span>

                                @if (isTargeted)
                                {
                                    <span class="page-rotation-pill">
                                        @Loc["WatermarkedBadge"]
                                    </span>
                                }
                                else
                                {
                                    <span class="file-badge">
                                        @Loc["SkippedPageBadge"]
                                    </span>
                                }
                            </div>

                            <div class="preview-canvas-holder" data-pdf-page="@pageNum">
                                <div class="preview-skeleton-pulse">
                                    <svg class="spin-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
                                    </svg>
                                    <span>@Loc["LoadingPreviews"]</span>
                                </div>

                                <img class="page-thumbnail-canvas" alt="@Loc["Page"] @pageNum" />

                                @if (isTargeted && CanShowLivePreview)
                                {
                                    @if (options.IsMosaic)
                                    {
                                        <div class="watermark-mosaic-stage @(options.Layer == WatermarkLayer.BelowContent ? "layer-below" : "")">
                                            @for (int tile = 0; tile < 12; tile++)
                                            {
                                                <div class="watermark-live-item" style="@GetLiveStampStyle(isMosaicTile: true)">
                                                    @if (options.Mode == WatermarkMode.Text)
                                                    {
                                                        <span>@options.Text</span>
                                                    }
                                                    else if (!string.IsNullOrEmpty(options.ImageDataUrl))
                                                    {
                                                        <img src="@options.ImageDataUrl" alt="Watermark" style="max-width: 46px; max-height: 36px; object-fit: contain;" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- iLovePDF Red Corner Anchor Indicator Dot -->
                                        <span class="thumbnail-pos-indicator pos-@options.Position"></span>

                                        <div class="watermark-live-stage pos-@options.Position @(options.Layer == WatermarkLayer.BelowContent ? "layer-below" : "")">
                                            <div class="watermark-live-item" style="@GetLiveStampStyle(isMosaicTile: false)">
                                                @if (options.Mode == WatermarkMode.Text)
                                                {
                                                    <span>@options.Text</span>
                                                }
                                                else if (!string.IsNullOrEmpty(options.ImageDataUrl))
                                                {
                                                    <img src="@options.ImageDataUrl" alt="Watermark" style="width: @(Math.Clamp(options.ImageScalePercent, 15, 90) * 1.45)px; max-height: 150px; object-fit: contain;" />
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Sticky Sidebar: iLovePDF Watermark Options -->
            <aside class="watermark-sidebar">
                <div class="watermark-sidebar-header">
                    @Loc["WatermarkOptionsTitle"]
                </div>

                <!-- Segmented Mode Switcher: Place Text / Place Image -->
                <div class="watermark-mode-tabs">
                    <button type="button" class="watermark-mode-tab @(options.Mode == WatermarkMode.Text ? "active" : "")"
                            @onclick="() => SetMode(WatermarkMode.Text)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="4 7 4 4 20 4 20 7"></polyline>
                            <line x1="9" y1="20" x2="15" y2="20"></line>
                            <line x1="12" y1="4" x2="12" y2="20"></line>
                        </svg>
                        <span>@Loc["PlaceText"]</span>
                    </button>

                    <button type="button" class="watermark-mode-tab @(options.Mode == WatermarkMode.Image ? "active" : "")"
                            @onclick="() => SetMode(WatermarkMode.Image)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        <span>@Loc["PlaceImage"]</span>
                    </button>
                </div>

                <div class="watermark-sidebar-body">
                    @if (options.Mode == WatermarkMode.Text)
                    {
                        <!-- Text Input & Presets -->
                        <div class="wm-section">
                            <label class="wm-label">@Loc["WatermarkTextLabel"]</label>
                            <input type="text" class="compact-input" style="width: 100%; padding: 0.55rem 0.75rem; font-size: 0.92rem;"
                                   placeholder="@Loc["WatermarkTextPlaceholder"]"
                                   @bind="options.Text" @bind:event="oninput" />

                            <div class="wm-preset-chips" style="margin-top: 0.25rem;">
                                @foreach (var preset in GetTextPresets())
                                {
                                    <button type="button" class="wm-preset-chip @(options.Text == preset ? "active" : "")"
                                            @onclick="() => options.Text = preset">
                                        @preset
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Text Format Bar -->
                        <div class="wm-section">
                            <label class="wm-label">@Loc["TextFormat"]</label>
                            <div class="wm-format-bar">
                                <select class="compact-input" style="flex: 1; min-width: 115px;" @bind="options.FontFamily">
                                    <option value="Segoe UI">Segoe UI</option>
                                    <option value="Arial">Arial</option>
                                    <option value="Times New Roman">Times New Roman</option>
                                    <option value="Calibri">Calibri</option>
                                </select>

                                <select class="compact-input" style="width: 72px;" @bind="options.FontSize">
                                    <option value="20">20 pt</option>
                                    <option value="28">28 pt</option>
                                    <option value="36">36 pt</option>
                                    <option value="48">48 pt</option>
                                    <option value="60">60 pt</option>
                                    <option value="72">72 pt</option>
                                    <option value="96">96 pt</option>
                                </select>

                                <button type="button" class="wm-style-btn @(options.IsBold ? "active" : "")"
                                        title="@Loc["Bold"]" @onclick="() => options.IsBold = !options.IsBold">
                                    B
                                </button>

                                <button type="button" class="wm-style-btn @(options.IsItalic ? "active" : "")"
                                        style="font-style: italic; font-family: Georgia, serif;"
                                        title="@Loc["Italic"]" @onclick="() => options.IsItalic = !options.IsItalic">
                                    I
                                </button>
                            </div>

                            <!-- Color Swatches + Custom Color Picker -->
                            <div class="wm-color-row" style="margin-top: 0.3rem;">
                                @foreach (var hex in ColorPalette)
                                {
                                    <button type="button" class="wm-color-swatch @(string.Equals(options.TextColorHex, hex, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                            style="background-color: @hex;"
                                            title="@hex"
                                            @onclick="() => options.TextColorHex = hex">
                                    </button>
                                }
                                <input type="color" @bind="options.TextColorHex" @bind:event="oninput"
                                       style="width: 28px; height: 28px; padding: 0; border: 1px solid var(--border-subtle); border-radius: 6px; cursor: pointer; background: transparent;" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Image Upload & Scale -->
                        <div class="wm-section">
                            <label class="wm-label">@Loc["PlaceImage"]</label>
                            <label class="smart-dropzone" style="padding: 1.15rem 0.85rem; border-radius: 10px;">
                                <InputFile class="dropzone-input-overlay" OnChange="OnWatermarkImageSelected" accept=".png,.jpg,.jpeg,.webp" />
                                @if (!string.IsNullOrEmpty(options.ImageDataUrl))
                                {
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.45rem;">
                                        <img src="@options.ImageDataUrl" alt="Watermark Logo" style="max-height: 64px; max-width: 160px; object-fit: contain; border-radius: 4px;" />
                                        <span style="font-size: 0.78rem; font-weight: 600; color: var(--brand-primary);">@options.ImageFileName (@Loc["ChangeImage"])</span>
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size: 0.84rem; font-weight: 600; color: var(--brand-primary);">
                                        @Loc["UploadWatermarkImage"]
                                    </div>
                                }
                            </label>

                            <div style="margin-top: 0.45rem;">
                                <div class="wm-label">
                                    <span>@Loc["ImageSizeScale"]</span>
                                    <span style="color: var(--brand-primary);">@options.ImageScalePercent%</span>
                                </div>
                                <input type="range" min="10" max="85" step="5"
                                       @bind="options.ImageScalePercent" @bind:event="oninput"
                                       style="width: 100%; accent-color: var(--brand-primary);" />
                            </div>
                        </div>
                    }

                    <!-- Position (iLovePDF 3x3 Grid) & Mosaic Checkbox -->
                    <div class="wm-section">
                        <label class="wm-label">@Loc["PositionAndMosaic"]</label>
                        <div class="wm-position-row">
                            <div class="position-grid-3x3 @(options.IsMosaic ? "disabled-grid" : "")">
                                @foreach (var pos in AllPositions)
                                {
                                    <button type="button"
                                            class="pos-cell @(options.Position == pos && !options.IsMosaic ? "active" : "")"
                                            title="@pos.ToString()"
                                            @onclick="() => SelectPosition(pos)">
                                        <span class="pos-dot"></span>
                                    </button>
                                }
                            </div>

                            <label class="mosaic-toggle-card @(options.IsMosaic ? "active" : "")">
                                <input type="checkbox" @bind="options.IsMosaic" />
                                <div>
                                    <div style="font-weight: 700; font-size: 0.85rem; color: var(--text-primary);">@Loc["MosaicMode"]</div>
                                    <div style="font-size: 0.74rem; color: var(--text-secondary); line-height: 1.3;">@Loc["MosaicDesc"]</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Transparency & Rotation Row -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                        <div class="wm-section">
                            <label class="wm-label">@Loc["Transparency"]</label>
                            <select class="compact-input" style="width: 100%;" @bind="options.OpacityPercent">
                                <option value="100">@Loc["NoTransparency"]</option>
                                <option value="75">25% (75% Opacity)</option>
                                <option value="50">50%</option>
                                <option value="25">75% (25% Opacity)</option>
                            </select>
                        </div>

                        <div class="wm-section">
                            <label class="wm-label">@Loc["Rotation"]</label>
                            <select class="compact-input" style="width: 100%;" @bind="options.RotationDegrees">
                                <option value="0">@Loc["DoNotRotate"]</option>
                                <option value="-45">-45 @Loc["Degrees"]</option>
                                <option value="45">45 @Loc["Degrees"]</option>
                                <option value="90">90 @Loc["Degrees"]</option>
                                <option value="180">180 @Loc["Degrees"]</option>
                                <option value="270">270 @Loc["Degrees"]</option>
                            </select>
                        </div>
                    </div>

                    <!-- Pages to Watermark -->
                    <div class="wm-section">
                        <label class="wm-label">@Loc["PagesToWatermark"]</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <button type="button" class="wm-preset-chip @(options.PageScope == "all" ? "active" : "")"
                                    style="flex: 1; padding: 0.45rem;"
                                    @onclick='() => options.PageScope = "all"'>
                                @Loc["ScopeAll"]
                            </button>
                            <button type="button" class="wm-preset-chip @(options.PageScope == "range" ? "active" : "")"
                                    style="flex: 1; padding: 0.45rem;"
                                    @onclick='() => options.PageScope = "range"'>
                                @Loc["ScopeCustom"]
                            </button>
                        </div>

                        @if (options.PageScope == "range")
                        {
                            <input type="text" class="compact-input" style="width: 100%; margin-top: 0.35rem;"
                                   placeholder="@Loc["RangePlaceholder"]"
                                   @bind="options.CustomRange" @bind:event="oninput" />
                        }
                    </div>

                    <!-- Layer (Over vs Below PDF content - iLovePDF Visual Cards) -->
                    <div class="wm-section">
                        <label class="wm-label">@Loc["LayerTitle"]</label>
                        <div class="layer-selector-grid">
                            <div class="layer-card @(options.Layer == WatermarkLayer.OverContent ? "active" : "")"
                                 @onclick="() => options.Layer = WatermarkLayer.OverContent">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                    <polyline points="2 17 12 22 22 17"></polyline>
                                    <polyline points="2 12 12 17 22 12"></polyline>
                                </svg>
                                <span>@Loc["LayerOver"]</span>
                            </div>

                            <div class="layer-card @(options.Layer == WatermarkLayer.BelowContent ? "active" : "")"
                                 @onclick="() => options.Layer = WatermarkLayer.BelowContent">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.75;">
                                    <polyline points="2 17 12 22 22 17"></polyline>
                                    <polyline points="2 12 12 17 22 12"></polyline>
                                    <polygon points="12 2 2 7 12 12 22 7 12 2" stroke-dasharray="2 2"></polygon>
                                </svg>
                                <span>@Loc["LayerBelow"]</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sticky Sidebar Footer CTA -->
                <div class="watermark-sidebar-footer">
                    <button type="button" class="btn-primary-action" disabled="@isProcessing" @onclick="ExecuteWatermark">
                        @if (isProcessing)
                        {
                            <span>@Loc["Processing"]</span>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                            </svg>
                            <span>@Loc["WatermarkButton"]</span>
                        }
                    </button>
                </div>
            </aside>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="margin-top: 1.25rem; padding: 0.85rem 1.25rem; background: var(--danger-surface); border: 1px solid var(--danger-border); border-radius: 8px; color: var(--danger); font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@errorMessage</span>
        </div>
    }

    <!-- Result Telemetry -->
    @if (lastResult != null && lastResult.Success)
    {
        <div class="telemetry-card">
            <div class="telemetry-header">
                <span style="display: flex; align-items: center; gap: 0.4rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>@Loc["WatermarkSuccess"]</span>
                </span>
                <span class="telemetry-speed">⚡ @lastResult.ElapsedMilliseconds @Loc["Milliseconds"]</span>
            </div>
            <div class="telemetry-summary">
                @lastResult.Summary
            </div>
            <div class="telemetry-note">
                @Loc["ZeroDiskIoNotice"]
            </div>
            <div style="margin-top: 0.35rem;">
                <button type="button" class="btn-primary-action" style="padding: 0.65rem 1.5rem; font-size: 0.92rem; width: auto;" @onclick="DownloadAgain">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>@Loc["DownloadResult"] (@lastResult.OutputFileName)</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly WatermarkPosition[] AllPositions = new[]
    {
        WatermarkPosition.TopLeft, WatermarkPosition.TopCenter, WatermarkPosition.TopRight,
        WatermarkPosition.MiddleLeft, WatermarkPosition.Center, WatermarkPosition.MiddleRight,
        WatermarkPosition.BottomLeft, WatermarkPosition.BottomCenter, WatermarkPosition.BottomRight
    };

    private static readonly string[] ColorPalette = new[]
    {
        "#EF4444", "#0F172A", "#2563EB", "#059669", "#D97706", "#7C3AED", "#64748B"
    };

    private DocumentItem? selectedFile;
    private PdfWatermarkOptions options = new();
    private int pageSize = 24;
    private int currentViewPage = 1;
    private int jumpPageNumber = 1;
    private bool isProcessing = false;
    private string? errorMessage;
    private ExecutionResult? lastResult;
    private bool needsThumbnailInit = false;

    private bool CanShowLivePreview =>
        (options.Mode == WatermarkMode.Text && !string.IsNullOrWhiteSpace(options.Text)) ||
        (options.Mode == WatermarkMode.Image && !string.IsNullOrEmpty(options.ImageDataUrl));

    private int TotalViewPages => selectedFile == null || pageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(selectedFile.PageCount / (double)pageSize));

    private int ViewStartIndex => selectedFile == null || pageSize <= 0
        ? 0
        : Math.Clamp((currentViewPage - 1) * pageSize, 0, Math.Max(0, selectedFile.PageCount - 1));

    private int ViewEndIndex => selectedFile == null
        ? 0
        : (pageSize <= 0 ? selectedFile.PageCount : Math.Min(selectedFile.PageCount, ViewStartIndex + pageSize));

    protected override void OnInitialized()
    {
        Loc.OnChange += OnLanguageChanged;
        options.Text = Loc["PresetConfidential"];
    }

    private void OnLanguageChanged()
    {
        if (options.Text == "CONFIDENTIAL" || options.Text == "سري للغاية")
        {
            options.Text = Loc["PresetConfidential"];
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsThumbnailInit && selectedFile?.Data != null)
        {
            needsThumbnailInit = false;
            try
            {
                await JS.InvokeVoidAsync("mnshor.initLazyPdfPreview", "pdf-thumbnails-grid", selectedFile.Data);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Lazy thumbnail init notice: {ex.Message}");
            }
        }
    }

    private string[] GetTextPresets() => new[]
    {
        Loc["PresetConfidential"],
        Loc["PresetDraft"],
        Loc["PresetCopy"],
        Loc["PresetDoNotCopy"]
    };

    private void SetMode(WatermarkMode mode)
    {
        options.Mode = mode;
        errorMessage = null;
    }

    private void SelectPosition(WatermarkPosition pos)
    {
        options.Position = pos;
        options.IsMosaic = false;
    }

    private string GetLiveStampStyle(bool isMosaicTile)
    {
        double opacity = Math.Clamp(options.OpacityPercent, 10, 100) / 100.0;
        double previewPx = isMosaicTile
            ? Math.Clamp(options.FontSize * 0.22, 8, 15)
            : Math.Clamp(options.FontSize * 0.36, 10, 32);

        string weight = options.IsBold ? "700" : "400";
        string style = options.IsItalic ? "italic" : "normal";

        return FormattableString.Invariant(
            $"opacity: {opacity:F2}; transform: rotate({options.RotationDegrees}deg); font-family: '{options.FontFamily}', sans-serif; font-size: {previewPx:F1}px; font-weight: {weight}; font-style: {style}; color: {options.TextColorHex};");
    }

    private bool IsPageTargeted(int pageNum)
    {
        if (selectedFile == null) return false;
        if (!string.Equals(options.PageScope, "range", StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.IsNullOrWhiteSpace(options.CustomRange))
            return false;

        var parts = options.CustomRange.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var part in parts)
        {
            if (part.Contains('-'))
            {
                var limits = part.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (limits.Length == 2 && int.TryParse(limits[0], out int s) && int.TryParse(limits[1], out int e))
                {
                    if (pageNum >= Math.Min(s, e) && pageNum <= Math.Max(s, e))
                        return true;
                }
            }
            else if (int.TryParse(part, out int single) && single == pageNum)
            {
                return true;
            }
        }

        return false;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        lastResult = null;
        var file = e.File;

        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Please select a valid PDF file.";
            return;
        }

        try
        {
            using var memoryStream = new MemoryStream();
            using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            await stream.CopyToAsync(memoryStream);
            var data = memoryStream.ToArray();

            int pages = PdfEngine.GetPageCount(data);

            selectedFile = new DocumentItem
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Size = file.Size,
                PageCount = pages,
                Data = data
            };

            currentViewPage = 1;
            jumpPageNumber = 1;
            needsThumbnailInit = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading {file.Name}: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task OnWatermarkImageSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;
        try
        {
            using var ms = new MemoryStream();
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            string mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            options.ImageData = bytes;
            options.ImageFileName = file.Name;
            options.ImageDataUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading image: {ex.Message}";
        }
    }

    private void PrevViewPage()
    {
        if (currentViewPage > 1) currentViewPage--;
    }

    private void NextViewPage()
    {
        if (currentViewPage < TotalViewPages) currentViewPage++;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            pageSize = newSize;
            currentViewPage = 1;
        }
    }

    private async Task JumpToPageAsync()
    {
        if (selectedFile == null) return;
        int target = Math.Clamp(jumpPageNumber, 1, selectedFile.PageCount);
        jumpPageNumber = target;

        if (pageSize > 0)
        {
            currentViewPage = ((target - 1) / pageSize) + 1;
        }

        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("mnshor.scrollToCard", $"page-card-{target}");
        }
        catch { }
    }

    private void ResetFile()
    {
        selectedFile = null;
        lastResult = null;
        errorMessage = null;
        needsThumbnailInit = false;
        _ = JS.InvokeVoidAsync("mnshor.disposePdfPreview");
    }

    private async Task ExecuteWatermark()
    {
        if (selectedFile == null) return;

        errorMessage = null;
        isProcessing = true;
        StateHasChanged();

        try
        {
            lastResult = await PdfEngine.WatermarkAsync(selectedFile, options);

            if (lastResult.Success)
            {
                await DownloadResult(lastResult);
            }
            else
            {
                errorMessage = lastResult.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAgain()
    {
        if (lastResult != null && lastResult.Success)
        {
            await DownloadResult(lastResult);
        }
    }

    private async Task DownloadResult(ExecutionResult result)
    {
        await JS.InvokeVoidAsync("mnshor.downloadFileFromByteArray", result.OutputFileName, result.ContentType, result.OutputData);
    }

    public void Dispose()
    {
        Loc.OnChange -= OnLanguageChanged;
    }
}
