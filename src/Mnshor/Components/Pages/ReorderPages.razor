@page "/reorder"
@rendermode InteractiveServer
@inject LocalizationState Loc
@inject IPdfEngine PdfEngine
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Loc["ReorderPdfTitle"] - @Loc["AppName"]</PageTitle>

<a href="/" class="back-link">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>@Loc["BackToTools"]</span>
</a>

<div class="panel-card">
    <div class="panel-header">
        <div>
            <h1 class="panel-title">@Loc["ReorderPdfTitle"]</h1>
            <p class="panel-desc">@Loc["ReorderPdfDesc"]</p>
        </div>
    </div>

    @if (selectedFile == null)
    {
        <label class="smart-dropzone">
            <InputFile class="dropzone-input-overlay" OnChange="OnFileSelected" accept=".pdf" />
            <div class="dropzone-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 3 21 3 21 8"></polyline>
                    <line x1="4" y1="20" x2="21" y2="3"></line>
                    <polyline points="21 16 21 21 16 21"></polyline>
                    <line x1="15" y1="15" x2="21" y2="21"></line>
                    <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
            </div>
            <div class="dropzone-text">@Loc["DragDropPrompt"]</div>
            <div class="dropzone-subtext">PDF files only (Max 500 MB)</div>
        </label>
    }
    else
    {
        <!-- Document Meta Header -->
        <div class="file-item" style="margin-bottom: 1.25rem;">
            <div class="file-info">
                <div class="file-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div>
                    <div class="file-name">@selectedFile.FileName</div>
                    <div class="file-meta-badges">
                        <span class="file-badge">@selectedFile.FormattedSize</span>
                        <span class="file-badge badge-accent">
                            @selectedFile.PageCount @Loc["PagesCount"]
                        </span>
                    </div>
                </div>
            </div>

            <div>
                <button type="button" class="btn-lang" @onclick="ResetFile" style="color: var(--danger); border-color: var(--danger-border); background: var(--danger-surface);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>@Loc["Remove"]</span>
                </button>
            </div>
        </div>

        <!-- Global Action Toolbar -->
        <div class="pdf-preview-toolbar">
            <div class="preview-toolbar-actions">
                <button type="button" class="btn-tool-action" @onclick="ReverseOrder" title="@Loc["ReverseOrder"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="17 1 21 5 17 9"></polyline>
                        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                        <polyline points="7 23 3 19 7 15"></polyline>
                        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                    </svg>
                    <span>@Loc["ReverseOrder"]</span>
                </button>

                <button type="button" class="btn-tool-action" @onclick="ResetOrder" title="@Loc["ResetOrder"]" style="color: var(--text-secondary);">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.9 3.2L21 8"></path>
                        <path d="M21 3v5h-5"></path>
                        <path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.9-3.2L3 16"></path>
                        <path d="M3 21v-5h5"></path>
                    </svg>
                    <span>@Loc["ResetOrder"]</span>
                </button>
            </div>

            <div>
                <button type="button" class="btn-primary-action" style="width: auto; padding: 0.55rem 1.6rem; font-size: 0.92rem;" disabled="@isProcessing" @onclick="ExecuteReorder">
                    @if (isProcessing)
                    {
                        <span>@Loc["Processing"]</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span>@Loc["ReorderButton"]</span>
                    }
                </button>
            </div>
        </div>

        <!-- Custom Order Sequence Input -->
        <div style="margin-bottom: 1rem; padding: 0.75rem 1.15rem; background: var(--bg-page); border: 1px solid var(--border-subtle); border-radius: 10px; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <label style="font-weight: 600; font-size: 0.86rem; color: var(--text-primary); white-space: nowrap;">
                @Loc["CustomSequencePrompt"]
            </label>
            <input type="text" @bind="customSequenceInput" placeholder="e.g. 3, 1, 2, 4-100"
                   class="compact-input" style="flex-grow: 1; min-width: 180px;" />
            <button type="button" class="btn-tool-action" @onclick="ApplyCustomSequence" style="background: var(--brand-surface); color: var(--brand-primary); border-color: var(--brand-border); padding: 0.38rem 0.85rem;">
                @Loc["ApplySequence"]
            </button>
        </div>

        <!-- Large Document Navigator (Go to Page & Pagination) -->
        <div class="large-pdf-nav-bar">
            <div class="nav-bar-group">
                <label style="font-weight: 600; color: var(--text-secondary);">@Loc["JumpToPage"]</label>
                <input type="number" min="1" max="@pageSequence.Count" @bind="jumpPageNumber" class="compact-input" style="width: 72px;" />
                <button type="button" class="btn-tool-action" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;" @onclick="JumpToPositionAsync">
                    @Loc["JumpButton"]
                </button>
            </div>

            <div class="nav-bar-group">
                <span style="color: var(--text-secondary);">
                    @Loc["ShowingPages"] <strong>@(ViewStartIndex + 1)–@(ViewEndIndex)</strong> @Loc["Of"] <strong>@pageSequence.Count</strong>
                </span>

                <button type="button" class="btn-tool-action" style="padding: 0.32rem 0.7rem; font-size: 0.8rem;"
                        disabled="@(currentViewPage <= 1)" @onclick="PrevViewPage">
                    @Loc["PrevView"]
                </button>
                <span style="font-weight: 600; padding: 0 0.25rem;">@currentViewPage / @TotalViewPages</span>
                <button type="button" class="btn-tool-action" style="padding: 0.32rem 0.7rem; font-size: 0.8rem;"
                        disabled="@(currentViewPage >= TotalViewPages)" @onclick="NextViewPage">
                    @Loc["NextView"]
                </button>

                <label style="color: var(--text-secondary); margin-inline-start: 0.4rem;">@Loc["PerPage"]</label>
                <select class="compact-input" value="@pageSize" @onchange="OnPageSizeChanged">
                    <option value="24">24</option>
                    <option value="48">48</option>
                    <option value="96">96</option>
                    <option value="0">@Loc["ShowAll"] (@pageSequence.Count)</option>
                </select>
            </div>
        </div>

        <!-- Interactive Page Grid with Drag & Drop + Direct Position Jump -->
        <div id="pdf-thumbnails-grid" class="page-thumbnails-grid">
            @for (int i = ViewStartIndex; i < ViewEndIndex; i++)
            {
                int index = i;
                int originalPageNum = pageSequence[index];

                <div @key="@($"{index}_{originalPageNum}")"
                     id="reorder-pos-@(index + 1)"
                     class="page-thumbnail-card @(dragOverIndex == index ? "drag-over-card" : "")"
                     draggable="true"
                     @ondragstart="() => OnDragStart(index)"
                     @ondragover="() => OnDragOver(index)"
                     @ondragover:preventDefault
                     @ondrop="() => OnDrop(index)">
                    <div class="page-card-header">
                        <div style="display: flex; align-items: center; gap: 0.3rem;" title="@Loc["MoveToPosition"]">
                            <span style="font-weight: 700; color: var(--brand-primary); font-size: 0.82rem;">#</span>
                            <input type="number"
                                   min="1"
                                   max="@pageSequence.Count"
                                   value="@(index + 1)"
                                   class="position-jump-input"
                                   @onchange="(e) => MovePageToPosition(index, e.Value?.ToString())" />
                        </div>

                        <span class="file-badge">
                            @Loc["OriginalPage"] @originalPageNum
                        </span>
                    </div>

                    <div class="preview-canvas-holder" data-pdf-page="@originalPageNum" style="cursor: grab;">
                        <div class="preview-skeleton-pulse">
                            <svg class="spin-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
                            </svg>
                            <span>@Loc["LoadingPreviews"]</span>
                        </div>

                        <img class="page-thumbnail-canvas" alt="@Loc["Page"] @originalPageNum" />
                    </div>

                    <div class="page-card-actions">
                        <button type="button" class="btn-rotate-mini" style="padding: 0.4rem 0.35rem;" disabled="@(index == 0)"
                                @onclick="() => MovePageToIndex(index, 0)" title="@Loc["MoveFirst"]">
                            <span>@(Loc.IsRtl ? "⇥" : "⇤")</span>
                        </button>

                        <button type="button" class="btn-rotate-mini" disabled="@(index == 0)"
                                @onclick="() => MovePage(index, -1)" title="@Loc["MoveUp"]">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                        </button>

                        <button type="button" class="btn-rotate-mini" disabled="@(index == pageSequence.Count - 1)"
                                @onclick="() => MovePage(index, 1)" title="@Loc["MoveDown"]">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="@(Loc.IsRtl ? "transform: rotate(180deg);" : "")">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>

                        <button type="button" class="btn-rotate-mini" style="padding: 0.4rem 0.35rem;" disabled="@(index == pageSequence.Count - 1)"
                                @onclick="() => MovePageToIndex(index, pageSequence.Count - 1)" title="@Loc["MoveLast"]">
                            <span>@(Loc.IsRtl ? "⇤" : "⇥")</span>
                        </button>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="btn-primary-action" disabled="@isProcessing" @onclick="ExecuteReorder">
            @if (isProcessing)
            {
                <span>@Loc["Processing"]</span>
            }
            else
            {
                <span>@Loc["ReorderButton"] (@pageSequence.Count @Loc["PagesCount"])</span>
            }
        </button>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="margin-top: 1.25rem; padding: 0.85rem 1.25rem; background: var(--danger-surface); border: 1px solid var(--danger-border); border-radius: 8px; color: var(--danger); font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@errorMessage</span>
        </div>
    }

    <!-- Result Telemetry -->
    @if (lastResult != null && lastResult.Success)
    {
        <div class="telemetry-card">
            <div class="telemetry-header">
                <span style="display: flex; align-items: center; gap: 0.4rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>@Loc["ReorderSuccess"]</span>
                </span>
                <span class="telemetry-speed">⚡ @lastResult.ElapsedMilliseconds @Loc["Milliseconds"]</span>
            </div>
            <div class="telemetry-summary">
                @lastResult.Summary
            </div>
            <div class="telemetry-note">
                @Loc["ZeroDiskIoNotice"]
            </div>
            <div style="margin-top: 0.35rem;">
                <button type="button" class="btn-primary-action" style="padding: 0.65rem 1.5rem; font-size: 0.92rem; width: auto;" @onclick="DownloadAgain">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>@Loc["DownloadResult"] (@lastResult.OutputFileName)</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private DocumentItem? selectedFile;
    private List<int> pageSequence = new();
    private string customSequenceInput = string.Empty;
    private int pageSize = 24;
    private int currentViewPage = 1;
    private int jumpPageNumber = 1;
    private int? draggedIndex;
    private int? dragOverIndex;
    private bool isProcessing = false;
    private string? errorMessage;
    private ExecutionResult? lastResult;
    private bool needsThumbnailInit = false;

    private int TotalViewPages => pageSequence.Count == 0 || pageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(pageSequence.Count / (double)pageSize));

    private int ViewStartIndex => pageSequence.Count == 0 || pageSize <= 0
        ? 0
        : Math.Clamp((currentViewPage - 1) * pageSize, 0, Math.Max(0, pageSequence.Count - 1));

    private int ViewEndIndex => pageSequence.Count == 0
        ? 0
        : (pageSize <= 0 ? pageSequence.Count : Math.Min(pageSequence.Count, ViewStartIndex + pageSize));

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsThumbnailInit && selectedFile?.Data != null)
        {
            needsThumbnailInit = false;
            try
            {
                await JS.InvokeVoidAsync("mnshor.initLazyPdfPreview", "pdf-thumbnails-grid", selectedFile.Data);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Lazy thumbnail init notice: {ex.Message}");
            }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        lastResult = null;
        var file = e.File;

        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Please select a valid PDF file.";
            return;
        }

        try
        {
            using var memoryStream = new MemoryStream();
            using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            await stream.CopyToAsync(memoryStream);
            var data = memoryStream.ToArray();

            int pages = PdfEngine.GetPageCount(data);

            selectedFile = new DocumentItem
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Size = file.Size,
                PageCount = pages,
                Data = data
            };

            pageSequence = Enumerable.Range(1, pages).ToList();
            UpdateCompactSequenceString();
            currentViewPage = 1;
            jumpPageNumber = 1;
            needsThumbnailInit = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading {file.Name}: {ex.Message}";
        }

        StateHasChanged();
    }

    private void MovePage(int index, int delta)
    {
        MovePageToIndex(index, index + delta);
    }

    private void MovePageToIndex(int fromIndex, int toIndex)
    {
        if (fromIndex >= 0 && fromIndex < pageSequence.Count && toIndex >= 0 && toIndex < pageSequence.Count && fromIndex != toIndex)
        {
            var item = pageSequence[fromIndex];
            pageSequence.RemoveAt(fromIndex);
            pageSequence.Insert(toIndex, item);
            UpdateCompactSequenceString();
        }
    }

    private void MovePageToPosition(int fromIndex, string? newPositionStr)
    {
        if (int.TryParse(newPositionStr, out int targetPos))
        {
            int targetIndex = Math.Clamp(targetPos - 1, 0, pageSequence.Count - 1);
            MovePageToIndex(fromIndex, targetIndex);
        }
    }

    private void OnDragStart(int index)
    {
        draggedIndex = index;
    }

    private void OnDragOver(int index)
    {
        dragOverIndex = index;
    }

    private void OnDrop(int targetIndex)
    {
        if (draggedIndex.HasValue && draggedIndex.Value != targetIndex)
        {
            MovePageToIndex(draggedIndex.Value, targetIndex);
        }
        draggedIndex = null;
        dragOverIndex = null;
    }

    private void ReverseOrder()
    {
        pageSequence.Reverse();
        UpdateCompactSequenceString();
    }

    private void ResetOrder()
    {
        if (selectedFile == null) return;
        pageSequence = Enumerable.Range(1, selectedFile.PageCount).ToList();
        UpdateCompactSequenceString();
    }

    private void UpdateCompactSequenceString()
    {
        if (pageSequence.Count == 0)
        {
            customSequenceInput = string.Empty;
            return;
        }

        var parts = new List<string>();
        int start = pageSequence[0];
        int prev = start;
        int dir = 0;

        for (int i = 1; i < pageSequence.Count; i++)
        {
            int cur = pageSequence[i];
            int step = cur - prev;
            if (dir == 0 && (step == 1 || step == -1))
            {
                dir = step;
                prev = cur;
            }
            else if (dir != 0 && step == dir)
            {
                prev = cur;
            }
            else
            {
                parts.Add(start == prev ? $"{start}" : $"{start}-{prev}");
                start = cur;
                prev = cur;
                dir = 0;
            }
        }
        parts.Add(start == prev ? $"{start}" : $"{start}-{prev}");
        customSequenceInput = string.Join(", ", parts);
    }

    private void ApplyCustomSequence()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(customSequenceInput)) return;

        var parts = customSequenceInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var parsed = new List<int>();

        foreach (var part in parts)
        {
            if (part.Contains('-'))
            {
                var limits = part.Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (limits.Length == 2 && int.TryParse(limits[0], out int s) && int.TryParse(limits[1], out int end))
                {
                    int step = s <= end ? 1 : -1;
                    for (int p = s; s <= end ? p <= end : p >= end; p += step)
                    {
                        if (p >= 1 && p <= selectedFile.PageCount) parsed.Add(p);
                    }
                }
            }
            else if (int.TryParse(part, out int single) && single >= 1 && single <= selectedFile.PageCount)
            {
                parsed.Add(single);
            }
        }

        if (parsed.Count > 0)
        {
            pageSequence = parsed;
            currentViewPage = 1;
            errorMessage = null;
        }
        else
        {
            errorMessage = Loc["InvalidSequence"];
        }
    }

    private void PrevViewPage()
    {
        if (currentViewPage > 1) currentViewPage--;
    }

    private void NextViewPage()
    {
        if (currentViewPage < TotalViewPages) currentViewPage++;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            pageSize = newSize;
            currentViewPage = 1;
        }
    }

    private async Task JumpToPositionAsync()
    {
        if (pageSequence.Count == 0) return;
        int target = Math.Clamp(jumpPageNumber, 1, pageSequence.Count);
        jumpPageNumber = target;

        if (pageSize > 0)
        {
            currentViewPage = ((target - 1) / pageSize) + 1;
        }

        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("mnshor.scrollToCard", $"reorder-pos-{target}");
        }
        catch { }
    }

    private void ResetFile()
    {
        selectedFile = null;
        pageSequence.Clear();
        customSequenceInput = string.Empty;
        lastResult = null;
        errorMessage = null;
        needsThumbnailInit = false;
        _ = JS.InvokeVoidAsync("mnshor.disposePdfPreview");
    }

    private async Task ExecuteReorder()
    {
        if (selectedFile == null || pageSequence.Count == 0) return;

        errorMessage = null;
        isProcessing = true;
        StateHasChanged();

        try
        {
            lastResult = await PdfEngine.ReorderPagesAsync(selectedFile, pageSequence);

            if (lastResult.Success)
            {
                await DownloadResult(lastResult);
            }
            else
            {
                errorMessage = lastResult.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAgain()
    {
        if (lastResult != null && lastResult.Success)
        {
            await DownloadResult(lastResult);
        }
    }

    private async Task DownloadResult(ExecutionResult result)
    {
        await JS.InvokeVoidAsync("mnshor.downloadFileFromByteArray", result.OutputFileName, result.ContentType, result.OutputData);
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
